# 複製成 .env 使用。一律走真 API(無 mock 模式)。
# 前端打 proxy 的基底路徑(Vite dev server 會把 /api 轉到 Express)。
VITE_API_BASE=/api

# ── Express proxy(server/index.js)專用,不以 VITE_ 開頭故不會進前端 bundle ──
EAP_API_BASE=https://cloud.geminidata.com/api/portal/api10
EAP_PROJECT_ID=你的 project id
EAP_TOKEN=你的 project token
PROXY_PORT=8787
